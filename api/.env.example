# TRS API – Konfiguration. Kopieren nach .env und ausfüllen. .env NIE committen.

# Cloudflare-Tunnel-Token (Zero Trust → Networks → Tunnels → Tunnel → Docker-Anleitung:
# der lange Wert hinter --token). Nur cloudflared bekommt ihn.
TUNNEL_TOKEN=

# Pflicht: mindestens 32 zufällige Zeichen, z. B.  openssl rand -base64 48
# Schlüssel für die Einlösecode-Hashes – nach dem ersten Start NICHT mehr ändern
# (sonst werden alle offenen Codes ungültig).
SECRET_KEY=

# Admins: Minecraft-UUIDs, kommagetrennt (mit oder ohne Bindestriche).
# Minecraft-Konto "Theredstonee" = 75c1a6f3112240abbdb57b9d21c64232
ADMIN_UUIDS=

# Optional: Schlüssel für Admin-Skripte (Header X-Admin-Key), mindestens 32 Zeichen.
# Leer = nur Admin-Sitzungen. Erzeugen: openssl rand -hex 32
ADMIN_API_KEY=

# Öffentliche Adresse (für Umhang-URLs in Antworten).
PUBLIC_BASE_URL=https://api.theredstonee.de
# Website (gleiche App); alte API-Namen leiten Seitenaufrufe dorthin weiter
SITE_URL=https://trs-launcher.theredstonee.de
API_ONLY_HOSTS=api.theredstonee.de

# Browser-Origins mit CORS-Zugriff, kommagetrennt, nur https (kein *).
# Launcher und Mod brauchen KEIN CORS – leer lassen, solange keine Webseite die API aufruft.
CORS_ORIGINS=

# Client-IP aus CF-Connecting-IP übernehmen (cloudflare) oder Socket-Adresse (none).
TRUST_PROXY=cloudflare

# Zugriffslog (Methode, Pfad, Status, Dauer – ohne IPs/Tokens).
LOG_REQUESTS=false

# Chat-Verschlüsselung (AES-256-GCM): "id:base64(32 Byte)", kommagetrennt, der ERSTE ist aktiv.
# Erzeugen: echo "k1:$(openssl rand -base64 32)". Leer = aus SECRET_KEY abgeleitet (Warnung im Log).
# Schlüsseltausch: neuen vorne eintragen, alten dahinter lassen (aus SECRET_KEY: "s1:derived"),
# neu starten, warten bis im Log "chat key rotation done" steht, erst dann den alten entfernen.
# Schlüssel NICHT verlieren (sonst sind die Chats unlesbar) und getrennt von DATA_DIR sichern.
CHAT_KEYS=

# Höchstens so viel Platz für Chat-Bilder insgesamt (MB). Danach 507 storage_full.
CHAT_STORAGE_MAX_MB=1024

# Server-Einladungen: Status (Icon, Spieler) vom TRS-Server abfragen (true) oder nicht (false).
SERVER_PING=true

# Welt-Hosting (API.md §21): gemeinsamer HMAC-Schlüssel mit dem Relay-Server „TRS Relay“
# (dort in dessen .env derselbe Wert). Erzeugen: openssl rand -base64 48
# Schlüsseltausch: "NEU,ALT" (die API signiert mit dem ersten). Leer = Hosting aus.
RELAY_SECRET=
# Öffentlicher Name des Relays (DNS-A-Record ohne Cloudflare-Proxy) + Ports.
RELAY_HOST=relay.theredstonee.de
RELAY_TCP_PORT=25503
RELAY_UDP_PORT=25504
# STUN-Server host:port (kommagetrennt). Leer = nur das Relay selbst.
HOSTING_STUN=
