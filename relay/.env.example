# TRS Relay – Konfiguration (Datei als .env neben start.sh ablegen, nie ins Git)

# Gemeinsamer HMAC-Schlüssel mit der TRS API (dort ebenfalls RELAY_SECRET).
# Erzeugen: openssl rand -base64 48
# Schlüsseltausch: neuen Schlüssel vorne anhängen, kommagetrennt (NEU,ALT) – das Relay
# akzeptiert beide; nach ein paar Minuten (Tokens leben ≤ 2 min) den alten entfernen.
RELAY_SECRET=

# Öffentliche Adresse (nur für die Log-Zeile; die API gibt den Clients Host + Ports).
PUBLIC_HOST=relay.theredstonee.de
# 135.125.185.232

# Bindung: 0.0.0.0 ist hier gewollt (öffentlicher Relay-Port, Zugang nur per Token).
BIND_HOST=0.0.0.0
# TCP_PORT fällt auf SERVER_PORT (primäre Allocation) zurück, sonst 25503.
# TCP_PORT=25503
# UDP = zweite Allocation des Servers.
UDP_PORT=25504

# Grenzen (Standardwerte)
MAX_ROOM_PLAYERS=10
MAX_CONNS_PER_GUEST=3
MAX_CONNECTIONS=1000
MAX_CONNS_PER_IP=20
NEW_CONNS_PER_IP_PER_MIN=60
HANDSHAKE_FAILS_PER_IP=30
ROOM_BANDWIDTH_MBIT=20
PIPE_IDLE_SEC=300
STUN_PER_IP_PER_SEC=20
UDP_BINDS_PER_IP_PER_MIN=30
